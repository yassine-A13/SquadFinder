generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PostType {
  TEAM_LOOKING_PLAYER
  PLAYER_LOOKING_TEAM
}

enum PostStatus {
  OPEN
  CLOSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum NotificationType {
  APPLICATION
  MESSAGE
  SYSTEM
  REVIEW
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  emailVerified       DateTime?
  password            String?
  image               String?
  role                Role                 @default(PLAYER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  sports              UserSport[]
  posts               Post[]
  applications        Application[]
  conversationMembers ConversationMember[]
  sentMessages        Message[]            @relation("MessageSender")
  notifications       Notification[]
  favorites           Favorite[]
  reviewsWritten      Review[]             @relation("Reviewer")
  reviewsReceived     Review[]             @relation("ReviewedUser")
  reportsFiled        Report[]             @relation("Reporter")
  reportsReceived     Report[]             @relation("ReportedUser")
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  city         String?
  age          Int?
  gender       Gender?
  bio          String?
  availability String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sport {
  id        String      @id @default(cuid())
  name      String      @unique
  icon      String?
  users     UserSport[]
  posts     Post[]
  createdAt DateTime    @default(now())
}

model UserSport {
  id      String @id @default(cuid())
  userId  String
  sportId String
  level   Level
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([userId, sportId])
  @@index([userId])
  @@index([sportId])
}

model Post {
  id            String        @id @default(cuid())
  authorId      String
  sportId       String
  title         String
  description   String
  city          String
  matchDate     DateTime
  matchTime     String
  requiredLevel Level
  playersNeeded Int
  type          PostType
  status        PostStatus    @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sport         Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  applications  Application[]
  favorites     Favorite[]

  @@index([authorId])
  @@index([sportId])
  @@index([city])
  @@index([status])
  @@index([sportId, city, status])
  @@index([matchDate])
}

model Application {
  id        String            @id @default(cuid())
  postId    String
  userId    String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([status])
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  content   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Review {
  id             String   @id @default(cuid())
  reviewerId     String
  reviewedUserId String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())
  reviewer       User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser   User     @relation("ReviewedUser", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([reviewedUserId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
